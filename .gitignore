# --- SQLite databases (local user data, incl. WAL/SHM sidecars) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
goals.db-*

# --- Build output (the .exe is produced by `wails build`, not committed) ---
build/bin/
dist/
*.exe

# --- Frontend generated ---
# NOTE: frontend/wailsjs/ (Wails Go bindings) is intentionally COMMITTED:
# plain `npm run build` (and CI) needs those files, and they only change
# when the Go bindings change. `wails build` regenerates them anyway.
frontend/dist/*
!frontend/dist/gitkeep
frontend/node_modules/
node_modules/

# --- Go ---
# (no local toolchain artifacts; module cache lives outside the repo)

# --- Env / secrets (never commit) ---
.env
.env.*
!.env.example

# --- Logs & temp ---
*.log
*.tmp
tmp/
temp/

# --- OS junk ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*~
